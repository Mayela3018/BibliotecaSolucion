<Window x:Class="BibliotecaSolucion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Biblioteca" Height="500" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header decorativo -->
        <Border Grid.Row="0" Background="{StaticResource ColorPrimary}" CornerRadius="0,0,30,30" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="📚" FontSize="36" HorizontalAlignment="Center" Foreground="White" Margin="0,0,0,5"/>
                <TextBlock Text="SISTEMA DE BIBLIOTECA" FontSize="20" FontWeight="Black" 
                           HorizontalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,20">
            <Button Content="📖 Mantenimiento de Libros" Width="280" Height="45" 
                    Margin="0,8" Click="BtnLibros_Click"/>

            <Button Content="👥 Mantenimiento de Socios" Width="280" Height="45" 
                    Margin="0,8" Click="BtnSocios_Click"/>

            <Button Content="📤 Registrar Préstamo" Width="280" Height="45" 
                    Margin="0,8" Click="BtnPrestamo_Click" Background="{StaticResource ColorTertiary}"/>

            <Button Content="📥 Registrar Devolución" Width="280" Height="45" 
                    Margin="0,8" Click="BtnDevolucion_Click" Background="{StaticResource ColorTertiary}"/>

            <Button Content="📊 Reporte de Préstamos" Width="280" Height="45" 
                    Margin="0,8" Click="BtnReporte_Click" Background="{StaticResource ColorSecondary}"/>
        </StackPanel>
    </Grid>
</Window>